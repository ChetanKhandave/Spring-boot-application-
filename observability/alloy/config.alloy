// File collection works for JVMs running from terminals or STS; no Docker socket access.
local.file_match "applications" {
  path_targets = [{"__path__" = "/var/log/apps/*.log", "job" = "spring-boot"}]
  sync_period = "5s"
}
loki.source.file "applications" {
  targets    = local.file_match.applications.targets
  forward_to = [loki.process.applications.receiver]
}
loki.process "applications" {
  stage.json {
    expressions = {service = "service", instance = "instance", level = "level"}
  }
  stage.labels {
    values = {service = "", instance = "", level = ""}
  }
  // traceId remains in the JSON body; never turn unique trace IDs into indexed labels.
  forward_to = [loki.write.local.receiver]
}
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
